					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><span class="mw-empty-elt" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox Organisation\n","href":"./Template:Infobox_Organisation"},"params":{"name":{"wt":"Archives du Maroc"},"logo":{"wt":"Archives-du-maroc-logo.png"},"logo_size":{"wt":"200"},"headquarters":{"wt":"[[Rabat]], Morocco"},"type":{"wt":"Public establishment"},"established":{"wt":"{{start date and age|2007}}"},"leader_title":{"wt":"Director"},"leader_name":{"wt":"Latifa Moftaqir&lt;ref>{{cite web|access-date=2026-04-22 |date=2024-10-17 |language=fr |title=Conseil des ministres : Qui est Latifa Moftaqir, nouvelle directrice des archives du Maroc ? |url=https://lopinion.ma/fr/actu-maroc/conseil-des-ministres--qui-est-latifa-moftaqir-nouvelle-directrice-des-archives-du-maroc-_a51574?articleId=7f86f5de-ea3c-4c4d-838c-1612a0e5f054 |website=L&apos;Opinion}}&lt;!-- auto-translated from French by Module:CS1 translator -->&lt;/ref>"},"parent_organization":{"wt":"[[Ministry of Youth, Culture and Communication (Morocco)|Ministry of Youth, Culture and Communication]]"},"website":{"wt":"[https://www.archivesdumaroc.ma/ archivesdumaroc.ma]"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt2" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style></span><table class="infobox vcard" about="#mwt1" id="mwAw"><caption class="infobox-title fn org">Archives du Maroc</caption><tbody><tr><td colspan="2" class="infobox-image logo"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Archives-du-maroc-logo.png" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Archives-du-maroc-logo.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Archives-du-maroc-logo.png/250px-Archives-du-maroc-logo.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Archives-du-maroc-logo.png/500px-Archives-du-maroc-logo.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="600" data-file-height="600" data-file-type="bitmap" height="200" width="200" class="mw-file-element"/></a></span></td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.6em;">Established</th><td class="infobox-data">2007<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>19<span typeof="mw:Entity"> </span>years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2007</span>)</span></td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.6em;">Type</th><td class="infobox-data">Public establishment</td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.6em;">Headquarters</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Rabat" title="Rabat">Rabat</a>, Morocco</td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.6em;"><div style="display: inline-block; line-height: 1.2em; padding: .1em 0; ">Director</div></th><td class="infobox-data">Latifa Moftaqir<sup about="#mwt5" class="mw-ref reference" id="cite_ref-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-1"}}'><a href="#cite_note-1" id="mwBA"><span class="mw-reflink-text" id="mwBQ"><span class="cite-bracket" id="mwBg">[</span>1<span class="cite-bracket" id="mwBw">]</span></span></a></sup></td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.6em;"><div style="display: inline-block; line-height: 1.2em; padding: .1em 0; ">Parent organization</div></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ministry_of_Youth,_Culture_and_Communication_(Morocco)?action=edit&amp;redlink=1" title="Ministry of Youth, Culture and Communication (Morocco) (page does not exist)" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Ministry of Youth, Culture and Communication (Morocco)"]}}'>Ministry of Youth, Culture and Communication</a></td></tr><tr><th scope="row" class="infobox-label" style="padding-right:0.6em;">Website</th><td class="infobox-data"><a rel="mw:ExtLink nofollow" href="https://www.archivesdumaroc.ma/" class="external text">archivesdumaroc.ma</a></td></tr></tbody></table>

<p id="mwCA"><b id="mwCQ">Archives du Maroc</b> is a Moroccan public institution responsible for the collection, preservation, and promotion of public <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Archives" title="Archives" class="mw-redirect" id="mwCg">archives</a>. Based in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Rabat" title="Rabat" id="mwCw">Rabat</a>, it contributes to safeguarding the national archival heritage and making it accessible to the public.</p>

<meta property="mw:PageProp/toc" id="mwDA" data-mw='{"autoGenerated":true}'/></section><section data-mw-section-id="1" id="mwDQ" aria-labelledby="History"><div class="mw-heading mw-heading2"><h2 id="History">History</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Archives_du_Maroc&amp;action=edit&amp;section=1" title="Edit section: History"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDg">Archives du Maroc was established in 2007 by Law No. 69-99 relating to archives. This law introduced a legal framework for the organization and management of public archives in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Morocco" title="Morocco" id="mwDw">Morocco</a>.<sup about="#mwt10" class="mw-ref reference" id="cite_ref-:0_2-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":0"},"body":{"id":"mw-reference-text-cite_note-:0-2"}}'><a href="#cite_note-:0-2" id="mwEA"><span class="mw-reflink-text" id="mwEQ"><span class="cite-bracket" id="mwEg">[</span>2<span class="cite-bracket" id="mwEw">]</span></span></a></sup></p>

<p id="mwFA">Before this reform, archival management was handled in a fragmented manner across different public administrations. The creation of the institution made it possible to structure archival policy and centralize the management of archival holdings.<sup about="#mwt11" class="mw-ref reference" id="cite_ref-:0_2-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":0"}}'><a href="#cite_note-:0-2" id="mwFQ"><span class="mw-reflink-text" id="mwFg"><span class="cite-bracket" id="mwFw">[</span>2<span class="cite-bracket" id="mwGA">]</span></span></a></sup></p>

</section><section data-mw-section-id="2" id="mwGQ" aria-labelledby="Missions"><div class="mw-heading mw-heading2"><h2 id="Missions">Missions</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Archives_du_Maroc&amp;action=edit&amp;section=2" title="Edit section: Missions"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwGg">Archives du Maroc is responsible for implementing the State’s policy on archives. Its missions include:<sup about="#mwt14" class="mw-ref reference" id="cite_ref-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-3"}}'><a href="#cite_note-3" id="mwGw"><span class="mw-reflink-text" id="mwHA"><span class="cite-bracket" id="mwHQ">[</span>3<span class="cite-bracket" id="mwHg">]</span></span></a></sup><sup about="#mwt17" class="mw-ref reference" id="cite_ref-4" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-4"}}'><a href="#cite_note-4" id="mwHw"><span class="mw-reflink-text" id="mwIA"><span class="cite-bracket" id="mwIQ">[</span>4<span class="cite-bracket" id="mwIg">]</span></span></a></sup><sup about="#mwt20" class="mw-ref reference" id="cite_ref-5" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-5"}}'><a href="#cite_note-5" id="mwIw"><span class="mw-reflink-text" id="mwJA"><span class="cite-bracket" id="mwJQ">[</span>5<span class="cite-bracket" id="mwJg">]</span></span></a></sup></p>

<ul id="mwJw"><li id="mwKA">the collection and receipt of public archives;</li>
<li id="mwKQ">the preservation, classification, and management of archival holdings;</li>
<li id="mwKg">the provision of access to archives for the public, in accordance with legal time limits;</li>
<li id="mwKw">the promotion of archival heritage, notably through exhibitions and publications;</li>
<li id="mwLA">the supervision of archival management within public administrations.</li></ul>

<p id="mwLQ">It also contributes to the development of standards and practices in the field of archiving.</p>

</section><section data-mw-section-id="3" id="mwLg" aria-labelledby="Organization"><div class="mw-heading mw-heading2"><h2 id="Organization">Organization</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Archives_du_Maroc&amp;action=edit&amp;section=3" title="Edit section: Organization"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwLw">Archives du Maroc is a public institution with legal personality and financial autonomy. It operates under the authority of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ministry_of_Youth,_Culture_and_Communication_(Morocco)?action=edit&amp;redlink=1" title="Ministry of Youth, Culture and Communication (Morocco) (page does not exist)" class="new" typeof="mw:LocalizedAttrs" id="mwMA" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Ministry of Youth, Culture and Communication (Morocco)"]}}'>Ministry of Youth, Culture and Communication</a>.<sup about="#mwt23" class="mw-ref reference" id="cite_ref-6" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-6"}}'><a href="#cite_note-6" id="mwMQ"><span class="mw-reflink-text" id="mwMg"><span class="cite-bracket" id="mwMw">[</span>6<span class="cite-bracket" id="mwNA">]</span></span></a></sup></p>

<p id="mwNQ">It is headed by a director and includes departments responsible for the collection, processing, preservation, and communication of archives.</p>

<p id="mwNg">The institution preserves documents produced by public administrations across various sectors of state activity. Its collections include administrative, historical, and institutional archives.<sup about="#mwt26" class="mw-ref reference" id="cite_ref-7" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-7"}}'><a href="#cite_note-7" id="mwNw"><span class="mw-reflink-text" id="mwOA"><span class="cite-bracket" id="mwOQ">[</span>7<span class="cite-bracket" id="mwOg">]</span></span></a></sup></p>

</section><section data-mw-section-id="4" id="mwOw" aria-labelledby="Activities"><div class="mw-heading mw-heading2"><h2 id="Activities">Activities</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Archives_du_Maroc&amp;action=edit&amp;section=4" title="Edit section: Activities"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwPA">Archives du Maroc conducts activities related to the management and dissemination of archives. It organizes exhibitions, conferences, and awareness initiatives.<sup about="#mwt29" class="mw-ref reference" id="cite_ref-8" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-8"}}'><a href="#cite_note-8" id="mwPQ"><span class="mw-reflink-text" id="mwPg"><span class="cite-bracket" id="mwPw">[</span>8<span class="cite-bracket" id="mwQA">]</span></span></a></sup></p>

<p id="mwQQ">The institution also contributes to training and supports public administrations in managing their archival records.</p>

</section><section data-mw-section-id="5" id="mwQg" aria-labelledby="See_also"><div class="mw-heading mw-heading2"><h2 id="See_also">See also</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Archives_du_Maroc&amp;action=edit&amp;section=5" title="Edit section: See also"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<ul id="mwQw"><li id="mwRA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Archives" title="Archives" class="mw-redirect" id="mwRQ">Archives</a></li>
