					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Government agency of Qatar"}},"i":0}}]}'>Government agency of Qatar</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_matches_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"Redirect","href":"./Template:Redirect"},"params":{"1":{"wt":"QCAA"},"2":{"wt":"the Queensland education authority"},"3":{"wt":"Queensland Curriculum and Assessment Authority"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2" id="mwBA">"QCAA" redirects here. For the Queensland education authority, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Queensland_Curriculum_and_Assessment_Authority" title="Queensland Curriculum and Assessment Authority">Queensland Curriculum and Assessment Authority</a>.</div>

<p class="mw-empty-elt" id="mwBQ"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt4" id="mwBg" data-mw='{"parts":[{"template":{"target":{"wt":"EngvarB","href":"./Template:EngvarB"},"params":{"date":{"wt":"October 2020"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_British_English_from_October_2020" about="#mwt4"/><link rel="mw:PageProp/Category" href="./Category:All_Wikipedia_articles_written_in_British_English" about="#mwt4" id="mwBw"/>
<span typeof="mw:Nowiki mw:Transclusion" about="#mwt5" id="mwCA" data-mw='{"parts":[{"template":{"target":{"wt":"Use dmy dates","href":"./Template:Use_dmy_dates"},"params":{"date":{"wt":"October 2020"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_dmy_dates_from_October_2020" about="#mwt5" id="mwCQ"/></p>

