					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Moroccan telecommunications company"}},"i":0}}]}'>Moroccan telecommunications company</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_matches_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox company\n","href":"./Template:Infobox_company"},"params":{"name":{"wt":"Inwi"},"logo":{"wt":"Logo_inwi.svg"},"logo_size":{"wt":""},"type":{"wt":"[[Private company]]"},"founded":{"wt":"{{start date and age|2009|4|}}"},"hq_location_city":{"wt":"[[Casablanca]]"},"hq_location_country":{"wt":"Morocco"},"founder":{"wt":"Karim Zaz"},"key_people":{"wt":"Nadia Fassi Fehri, [[Chief Executive Officer]] (2015–)"},"num_employees":{"wt":"{{formatnum:1300}} +"},"industry":{"wt":"[[Telecommunications]]"},"products":{"wt":"{{ubl|[[Landline|Fixed line telephone]]|[[Mobile phone]]|[[Broadband]]||[[IPTV]]|[[Internet]]|[[Banking]]}}"},"revenue":{"wt":""},"net_income":{"wt":""},"website":{"wt":"[https://www.inwi.ma inwi.ma]"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style><style data-mw-deduplicate="TemplateStyles:r1326365004" typeof="mw:Extension/templatestyles" about="#mwt4" data-mw='{"name":"templatestyles","attrs":{"src":"Infobox company/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .ib-company .infobox-label{padding-right:0.5em}.mw-parser-output .ib-company-logo img{background-color:#f8f9fa;color:inherit}.mw-parser-output .ib-company-logo .logo-nobg img{background-color:inherit;color:inherit}.mw-parser-output .ib-company-locality,.mw-parser-output .ib-company-country{display:inline}</style></span><table class="infobox ib-company vcard" about="#mwt2" id="mwBA"><tbody><tr><th colspan="2" class="infobox-above fn org">Inwi</th></tr><tr><td colspan="2" class="infobox-image ib-company-logo logo"><span class="mw-default-size logo-nobg" typeof="mw:File/Frameless"><a href="https://en.wikipedia.org/wiki/File:Logo_inwi.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Logo_inwi.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Logo_inwi.svg/250px-Logo_inwi.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Logo_inwi.svg/500px-Logo_inwi.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="156" data-file-type="drawing" height="76" width="250" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1"/></a></span></td></tr><tr><th scope="row" class="infobox-label">Type</th><td class="infobox-data category"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Private_company" title="Private company" class="mw-redirect">Private company</a></td></tr><tr><th scope="row" class="infobox-label">Industry</th><td class="infobox-data category"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Telecommunications" title="Telecommunications">Telecommunications</a></td></tr><tr><th scope="row" class="infobox-label">Founded</th><td class="infobox-data">April<span typeof="mw:Entity"> </span>2009<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>17<span typeof="mw:Entity"> </span>years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2009-04</span>)</span></td></tr><tr><th scope="row" class="infobox-label">Founder</th><td class="infobox-data agent">Karim Zaz</td></tr><tr><th scope="row" class="infobox-label">Headquarters</th><td class="infobox-data adr"><div class="ib-company-locality locality"> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Casablanca" title="Casablanca">Casablanca</a></div>, <div class="ib-company-country country-name"> Morocco</div><span style="display:none" data-plural="1"></span></td></tr><tr><th scope="row" class="infobox-label">Key<span typeof="mw:Entity"> </span>people</th><td class="infobox-data agent">Nadia Fassi Fehri, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Chief_Executive_Officer" title="Chief Executive Officer" class="mw-redirect">Chief Executive Officer</a> (2015–)</td></tr><tr><th scope="row" class="infobox-label">Products</th><td class="infobox-data"><span class="mw-empty-elt"><style data-mw-deduplicate="TemplateStyles:r1126788409" typeof="mw:Extension/templatestyles" about="#mwt5" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style></span><div class="plainlist"><ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Landline" title="Landline">Fixed line telephone</a></li><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mobile_phone" title="Mobile phone">Mobile phone</a></li><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Broadband" title="Broadband">Broadband</a></li><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPTV" title="IPTV" class="mw-redirect">IPTV</a></li><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet" title="Internet">Internet</a></li><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Banking" title="Banking" class="mw-redirect">Banking</a></li></ul></div></td></tr><tr><th scope="row" class="infobox-label"><div style="display: inline-block; line-height: 1.2em; padding: .1em 0; ">Number of employees</div></th><td class="infobox-data">1,300 +</td></tr><tr><th scope="row" class="infobox-label">Website</th><td class="infobox-data"><a rel="mw:ExtLink nofollow" href="https://www.inwi.ma" class="external text">inwi.ma</a></td></tr></tbody></table>

<p id="mwBQ"><b id="mwBg">Inwi</b> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Arabic_language" title="Arabic language" about="#mwt6" typeof="mw:Transclusion" class="mw-redirect" id="mwBw" data-mw='{"parts":[{"template":{"target":{"wt":"langx","href":"./Template:Langx"},"params":{"1":{"wt":"ar"},"2":{"wt":" إنوي"}},"i":0}}]}'>Arabic</a><span about="#mwt6">: </span><span lang="ar" dir="rtl" about="#mwt6">إنوي</span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Arabic-language_text" about="#mwt6" id="mwCA"/>), formerly known as <i id="mwCQ">Wana</i>, is a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Telecommunication" title="Telecommunication" class="mw-redirect" id="mwCg">telecommunications</a> company in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Morocco" title="Morocco" id="mwCw">Morocco</a>. Founded in 2009, it is a subsidiary of the Moroccan holding <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Al_Mada_(holding)" title="Al Mada (holding)" class="mw-redirect" id="mwDA">Al Mada</a> and the Kuwaiti group <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Zain_Group" title="Zain Group" id="mwDQ">Zain</a>.</p>

<p id="mwDg">With more than 380 branches, Inwi is the third largest telecommunications company in Morocco, after <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Maroc_Telecom" title="Maroc Telecom" id="mwDw">Maroc Telecom</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Orange_Morocco" title="Orange Morocco" id="mwEA">Orange</a>.<sup about="#mwt9" class="mw-ref reference" id="cite_ref-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-1"}}'><a href="#cite_note-1" id="mwEQ"><span class="mw-reflink-text" id="mwEg"><span class="cite-bracket" id="mwEw">[</span>1<span class="cite-bracket" id="mwFA">]</span></span></a></sup><sup about="#mwt12" class="mw-ref reference" id="cite_ref-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-2"}}'><a href="#cite_note-2" id="mwFQ"><span class="mw-reflink-text" id="mwFg"><span class="cite-bracket" id="mwFw">[</span>2<span class="cite-bracket" id="mwGA">]</span></span></a></sup> Inwi's network covers more than 92% of the country's territory.<sup about="#mwt15" class="mw-ref reference" id="cite_ref-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-3"}}'><a href="#cite_note-3" id="mwGQ"><span class="mw-reflink-text" id="mwGg"><span class="cite-bracket" id="mwGw">[</span>3<span class="cite-bracket" id="mwHA">]</span></span></a></sup></p>

<meta property="mw:PageProp/toc" id="mwHQ" data-mw='{"autoGenerated":true}'/></section><section data-mw-section-id="1" id="mwHg" aria-labelledby="History"><div class="mw-heading mw-heading2"><h2 id="History">History</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=1" title="Edit section: History"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwHw">Based in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Casablanca" title="Casablanca" id="mwIA">Casablanca</a>,<sup about="#mwt18" class="mw-ref reference" id="cite_ref-4" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-4"}}'><a href="#cite_note-4" id="mwIQ"><span class="mw-reflink-text" id="mwIg"><span class="cite-bracket" id="mwIw">[</span>4<span class="cite-bracket" id="mwJA">]</span></span></a></sup> Wanadoo Maroc was created in 1999 by Karim Zaz.<sup about="#mwt21" class="mw-ref reference" id="cite_ref-5" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-5"}}'><a href="#cite_note-5" id="mwJQ"><span class="mw-reflink-text" id="mwJg"><span class="cite-bracket" id="mwJw">[</span>5<span class="cite-bracket" id="mwKA">]</span></span></a></sup> In 2004, and following the withdrawal of France Telecom, Wanadoo Morocco sold its subsidiary Maroc Connect to local investors <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Attijariwafa_Bank" title="Attijariwafa Bank" id="mwKQ">Attijariwafa bank</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Caisse_de_Dépôt_et_de_Gestion" title="Caisse de Dépôt et de Gestion" id="mwKg">Caisse de Dépôt et de Gestion</a> (CDG) via its subsidiary, Fipar holding.<sup about="#mwt24" class="mw-ref reference" id="cite_ref-6" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-6"}}'><a href="#cite_note-6" id="mwKw"><span class="mw-reflink-text" id="mwLA"><span class="cite-bracket" id="mwLQ">[</span>6<span class="cite-bracket" id="mwLg">]</span></span></a></sup><sup about="#mwt27" class="mw-ref reference" id="cite_ref-7" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-7"}}'><a href="#cite_note-7" id="mwLw"><span class="mw-reflink-text" id="mwMA"><span class="cite-bracket" id="mwMQ">[</span>7<span class="cite-bracket" id="mwMg">]</span></span></a></sup></p>

<p id="mwMw">In 2005, ONA became the reference shareholder of Maroc Connect.<sup about="#mwt30" class="mw-ref reference" id="cite_ref-8" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-8"}}'><a href="#cite_note-8" id="mwNA"><span class="mw-reflink-text" id="mwNQ"><span class="cite-bracket" id="mwNg">[</span>8<span class="cite-bracket" id="mwNw">]</span></span></a></sup> In 2006, Maroc Connect won the third 3G license in Morocco.<sup about="#mwt33" class="mw-ref reference" id="cite_ref-9" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-9"}}'><a href="#cite_note-9" id="mwOA"><span class="mw-reflink-text" id="mwOQ"><span class="cite-bracket" id="mwOg">[</span>9<span class="cite-bracket" id="mwOw">]</span></span></a></sup></p>

<p id="mwPA">In 2007, Maroc Connect became Wana,<sup about="#mwt36" class="mw-ref reference" id="cite_ref-10" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-10"}}'><a href="#cite_note-10" id="mwPQ"><span class="mw-reflink-text" id="mwPg"><span class="cite-bracket" id="mwPw">[</span>10<span class="cite-bracket" id="mwQA">]</span></span></a></sup> the third operator for home telephones and 3G internet. In 2009, Wana won the third GSM license in Morocco under its Inwi brand.<sup about="#mwt39" class="mw-ref reference" id="cite_ref-11" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-11"}}'><a href="#cite_note-11" id="mwQQ"><span class="mw-reflink-text" id="mwQg"><span class="cite-bracket" id="mwQw">[</span>11<span class="cite-bracket" id="mwRA">]</span></span></a></sup> In February, the Kuwaiti consortium Zain/Alajial took control of 31% of Inwi's capital.<sup about="#mwt42" class="mw-ref reference" id="cite_ref-12" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-12"}}'><a href="#cite_note-12" id="mwRQ"><span class="mw-reflink-text" id="mwRg"><span class="cite-bracket" id="mwRw">[</span>12<span class="cite-bracket" id="mwSA">]</span></span></a></sup> A year after its launch, Inwi reported five million customers in February 2010 and 13.5% of market shares in December 2010.<sup about="#mwt45" class="mw-ref reference" id="cite_ref-13" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-13"}}'><a href="#cite_note-13" id="mwSQ"><span class="mw-reflink-text" id="mwSg"><span class="cite-bracket" id="mwSw">[</span>13<span class="cite-bracket" id="mwTA">]</span></span></a></sup></p>

<p id="mwTQ">In March 2015, Wana obtained its 4G license for the Inwi brand. The Brand had the best rating according to the criteria set by the ARNT (Coverage commitment, quality of service and business plan for the deployment of high and very high speed broadband in Morocco).<sup about="#mwt48" class="mw-ref reference" id="cite_ref-14" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-14"}}'><a href="#cite_note-14" id="mwTg"><span class="mw-reflink-text" id="mwTw"><span class="cite-bracket" id="mwUA">[</span>14<span class="cite-bracket" id="mwUQ">]</span></span></a></sup></p>

<p id="mwUg">The decision of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Telecommunications_Regulatory_Agency_(Morocco)" title="National Telecommunications Regulatory Agency (Morocco)" class="mw-redirect" id="mwUw">ARNT</a> to block the VoIP provoked a campaign of online protests against various Moroccan operators, including Inwi, in 2016. The company reacted by withdrawing from the sponsorship of the Maroc Web Awards and started the development of an application to use VoIP services.<sup about="#mwt51" class="mw-ref reference" id="cite_ref-15" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-15"}}'><a href="#cite_note-15" id="mwVA"><span class="mw-reflink-text" id="mwVQ"><span class="cite-bracket" id="mwVg">[</span>15<span class="cite-bracket" id="mwVw">]</span></span></a></sup></p>

<p id="mwWA">In September 2016, Inwi was the first operator to offer VoLTE (Voice Over LTE) technology to its 4G subscribers.<sup about="#mwt54" class="mw-ref reference" id="cite_ref-16" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-16"}}'><a href="#cite_note-16" id="mwWQ"><span class="mw-reflink-text" id="mwWg"><span class="cite-bracket" id="mwWw">[</span>16<span class="cite-bracket" id="mwXA">]</span></span></a></sup> Also in 2016, Inwi was awarded the Moroccan Digital Awards, which recognizes the best companies that stand out in the digital world, for its social initiative "Dir Iddik", a platform linking the associative world with volunteers. More than 50,000 people have registered since then.<sup about="#mwt57" class="mw-ref reference" id="cite_ref-17" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-17"}}'><a href="#cite_note-17" id="mwXQ"><span class="mw-reflink-text" id="mwXg"><span class="cite-bracket" id="mwXw">[</span>17<span class="cite-bracket" id="mwYA">]</span></span></a></sup></p>

<p id="mwYQ">In 2020, Inwi became the official sponsor of the Moroccan first- and second-division professional football championships.<sup about="#mwt60" class="mw-ref reference" id="cite_ref-18" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-18"}}'><a href="#cite_note-18" id="mwYg"><span class="mw-reflink-text" id="mwYw"><span class="cite-bracket" id="mwZA">[</span>18<span class="cite-bracket" id="mwZQ">]</span></span></a></sup> As a result, the championship has been known as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Botola_Pro" title="Botola Pro" id="mwZg"><i id="mwZw">Botola Pro Inwi</i></a> since the 2020–2021 season.<sup about="#mwt63" class="mw-ref reference" id="cite_ref-19" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-19"}}'><a href="#cite_note-19" id="mwaA"><span class="mw-reflink-text" id="mwaQ"><span class="cite-bracket" id="mwag">[</span>19<span class="cite-bracket" id="mwaw">]</span></span></a></sup></p>

<p id="mwbA">In 2023, Inwi expanded collaboration with Subex to utilize AI-driven fraud management and business assurance on HyperSense platform.</p>

<p id="mwbQ">In November 2025, Inwi, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Maroc_Telecom" title="Maroc Telecom" id="mwbg">Maroc Telecom</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Orange_Morocco" title="Orange Morocco" id="mwbw">Orange Morocco</a> introduced 5G, covering major cities.<sup about="#mwt66" class="mw-ref reference" id="cite_ref-20" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-20"}}'><a href="#cite_note-20" id="mwcA"><span class="mw-reflink-text" id="mwcQ"><span class="cite-bracket" id="mwcg">[</span>20<span class="cite-bracket" id="mwcw">]</span></span></a></sup></p>

</section><section data-mw-section-id="2" id="mwdA" aria-labelledby="Activities"><div class="mw-heading mw-heading2"><h2 id="Activities">Activities</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=2" title="Edit section: Activities"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<section data-mw-section-id="3" id="mwdQ" aria-labelledby="Mobile_phones"><div class="mw-heading mw-heading3"><h3 id="Mobile_phones">Mobile phones</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=3" title="Edit section: Mobile phones"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwdg">The operator holds 24.20% of the entire mobile phone flee, in 2016.<sup about="#mwt69" class="mw-ref reference" id="cite_ref-21" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-21"}}'><a href="#cite_note-21" id="mwdw"><span class="mw-reflink-text" id="mweA"><span class="cite-bracket" id="mweQ">[</span>21<span class="cite-bracket" id="mweg">]</span></span></a></sup> Following the opening of 07 numbers by the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ANRT" title="ANRT" class="mw-redirect" id="mwew">ANRT</a>, Inwi customers were offered the possibility to customize their phone number.<sup about="#mwt72" class="mw-ref reference" id="cite_ref-22" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-22"}}'><a href="#cite_note-22" id="mwfA"><span class="mw-reflink-text" id="mwfQ"><span class="cite-bracket" id="mwfg">[</span>22<span class="cite-bracket" id="mwfw">]</span></span></a></sup></p>

</section><section data-mw-section-id="4" id="mwgA" aria-labelledby="Home_phones"><div class="mw-heading mw-heading3"><h3 id="Home_phones">Home phones</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=4" title="Edit section: Home phones"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwgQ">With the Bayn brand, Inwi offers a restricted mobility offer on the CDMA network.</p>

</section><section data-mw-section-id="5" id="mwgg" aria-labelledby="Internet"><div class="mw-heading mw-heading3"><h3 id="Internet">Internet</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=5" title="Edit section: Internet"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwgw">Inwi offers Internet access for professionals via broadband ADSL and fiber optics as well as 4G and 5G coverage for individuals. In June 2016, the brand holds 25.15% of the market's share, in second position behind Maroc Telecom.<sup about="#mwt75" class="mw-ref reference" id="cite_ref-23" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-23"}}'><a href="#cite_note-23" id="mwhA"><span class="mw-reflink-text" id="mwhQ"><span class="cite-bracket" id="mwhg">[</span>23<span class="cite-bracket" id="mwhw">]</span></span></a></sup> It holds more than 17 million internet subscribers.<sup about="#mwt78" class="mw-ref reference" id="cite_ref-24" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-24"}}'><a href="#cite_note-24" id="mwiA"><span class="mw-reflink-text" id="mwiQ"><span class="cite-bracket" id="mwig">[</span>24<span class="cite-bracket" id="mwiw">]</span></span></a></sup></p>

</section><section data-mw-section-id="6" id="mwjA" aria-labelledby="VoIP_service"><div class="mw-heading mw-heading3"><h3 id="VoIP_service">VoIP service</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=6" title="Edit section: VoIP service"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwjQ">Born from the alliance between Wana and the French company "Phone Systems &amp; Network" in 2007, Bladiphone offers a communication service between France and Morocco through VoIP technology.<sup about="#mwt81" class="mw-ref reference" id="cite_ref-25" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-25"}}'><a href="#cite_note-25" id="mwjg"><span class="mw-reflink-text" id="mwjw"><span class="cite-bracket" id="mwkA">[</span>25<span class="cite-bracket" id="mwkQ">]</span></span></a></sup></p>

</section><section data-mw-section-id="7" id="mwkg" aria-labelledby="Double_Play_Offer"><div class="mw-heading mw-heading3"><h3 id="Double_Play_Offer">Double Play Offer</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=7" title="Edit section: Double Play Offer"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwkw">In 2017 and in partnership with the brand WanaOne, the operator developed a box to allow a reinforced access to Internet and telephone for companies.<sup about="#mwt84" class="mw-ref reference" id="cite_ref-26" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-26"}}'><a href="#cite_note-26" id="mwlA"><span class="mw-reflink-text" id="mwlQ"><span class="cite-bracket" id="mwlg">[</span>26<span class="cite-bracket" id="mwlw">]</span></span></a></sup></p>

</section><section data-mw-section-id="8" id="mwmA" aria-labelledby="Cloud"><div class="mw-heading mw-heading3"><h3 id="Cloud">Cloud</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=8" title="Edit section: Cloud"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwmQ">As of 2016, the operator proposed a professional service Cloud called "Business Digital Workplace".<sup about="#mwt87" class="mw-ref reference" id="cite_ref-27" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-27"}}'><a href="#cite_note-27" id="mwmg"><span class="mw-reflink-text" id="mwmw"><span class="cite-bracket" id="mwnA">[</span>27<span class="cite-bracket" id="mwnQ">]</span></span></a></sup> This service includes:<sup about="#mwt90" class="mw-ref reference" id="cite_ref-28" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-28"}}'><a href="#cite_note-28" id="mwng"><span class="mw-reflink-text" id="mwnw"><span class="cite-bracket" id="mwoA">[</span>28<span class="cite-bracket" id="mwoQ">]</span></span></a></sup></p> 
<ul id="mwog"><li id="mwow">Infrastructure as a Service IaaS</li>
<li id="mwpA">Desktop as a Service, DaaS</li>
<li id="mwpQ">Software as a Service, SaaS</li>
<li id="mwpg">Voice as a Service, VaaS</li></ul>

</section></section><section data-mw-section-id="9" id="mwpw" aria-labelledby="Other_activities"><div class="mw-heading mw-heading2"><h2 id="Other_activities">Other activities</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=9" title="Edit section: Other activities"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwqA">Starting from October 2016, Inwi developed a consulting activity for digital companies (particularly Green tech and smart cities), via partnership with Numa Casablanca incubator. A dedicated incubation area (Open Lab Inwi) and other programs of training and raising awareness (Datacity) were launched on this occasion.<sup about="#mwt93" class="mw-ref reference" id="cite_ref-29" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-29"}}'><a href="#cite_note-29" id="mwqQ"><span class="mw-reflink-text" id="mwqg"><span class="cite-bracket" id="mwqw">[</span>29<span class="cite-bracket" id="mwrA">]</span></span></a></sup><sup about="#mwt96" class="mw-ref reference" id="cite_ref-30" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-30"}}'><a href="#cite_note-30" id="mwrQ"><span class="mw-reflink-text" id="mwrg"><span class="cite-bracket" id="mwrw">[</span>30<span class="cite-bracket" id="mwsA">]</span></span></a></sup> On the occasion of the COP22 that took place in Morocco by the end of 2016, Inwi partnered with Moroccan Game Developers (MGD) to plan a contest that promotes the creation of Moroccan video games.<sup about="#mwt99" class="mw-ref reference" id="cite_ref-31" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-31"}}'><a href="#cite_note-31" id="mwsQ"><span class="mw-reflink-text" id="mwsg"><span class="cite-bracket" id="mwsw">[</span>31<span class="cite-bracket" id="mwtA">]</span></span></a></sup></p>

</section><section data-mw-section-id="10" id="mwtQ" aria-labelledby="See_also"><div class="mw-heading mw-heading2"><h2 id="See_also">See also</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=10" title="Edit section: See also"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<ul id="mwtg"><li id="mwtw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_censorship_in_Morocco" title="Internet censorship in Morocco" id="mwuA">Internet censorship in Morocco</a></li>
<li id="mwuQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Communications_in_Morocco" title="Communications in Morocco" class="mw-redirect" id="mwug">Communications in Morocco</a></li>
<li id="mwuw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_telephone_operating_companies" title="List of telephone operating companies" class="mw-redirect" id="mwvA">List of telephone operating companies</a></li>
<li id="mwvQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Orange_Morocco" title="Orange Morocco" id="mwvg">Orange</a> (previously Meditel)</li>
<li id="mwvw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Maroc_Telecom" title="Maroc Telecom" id="mwwA">Maroc Telecom</a></li>
<li id="mwwQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_in_Morocco" title="Internet in Morocco" id="mwwg">Internet in Morocco</a></li>
<li id="mwww"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Karim_Zaz?action=edit&amp;redlink=1" title="Karim Zaz (page does not exist)" class="new" typeof="mw:LocalizedAttrs" id="mwxA" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Karim Zaz"]}}'>Karim Zaz</a></li></ul>

</section><section data-mw-section-id="11" id="mwxQ" aria-labelledby="References"><div class="mw-heading mw-heading2"><h2 id="References">References</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Inwi&amp;action=edit&amp;section=11" title="Edit section: References"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
