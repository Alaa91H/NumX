					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Telecommunications company of Morocco"}},"i":0}}]}'>Telecommunications company of Morocco</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox company\n","href":"./Template:Infobox_company"},"params":{"name":{"wt":"Maroc Telecom"},"logo":{"wt":"Maroc Telecom logo.png"},"logo_size":{"wt":""},"logo_caption":{"wt":"Logo used since November 6th, 2025"},"image":{"wt":""},"image_caption":{"wt":""},"type":{"wt":"[[Public company|Public]]"},"traded_as":{"wt":"{{unbulleted list\n|[[Casablanca Stock Exchange|CSE Casablanca]]: [https://www.casablanca-bourse.com/en/live-market/instruments/IAM IAM]\n|{{EuronextParis|IAM|MA0000011488}}\n}}"},"predecessor":{"wt":"[[Office national des postes et télécommunications]]"},"founded":{"wt":"{{start date and age|1998|2|3}}"},"hq_location":{"wt":"[[Rabat]], [[Morocco]]"},"key_people":{"wt":"[[Mohamed Benchaaboun]] ([[chairman]] &amp; [[Chief Executive Officer|CEO]])&lt;br />Laurent Mairot ([[Chief Financial Officer|CFO]])"},"owners":{"wt":"{{ubl|[[Etisalat by e&amp;]] (53%)|[[Moroccan government]] (22%)}}"},"num_employees":{"wt":"10,609 (2018)"},"parent":{"wt":""},"subsidiaries":{"wt":"{{unbulleted list\n| Casanet\n| [[Mauritel]]\n| Moov Africa Burkina Faso\n| [[Gabon Telecom]]\n| [[Sotelma|Moov Africa Malitel]]\n| Moov Africa Côte d&apos;Ivoire\n| Moov Africa Benin\n| Moov Africa Togo\n| Moov Africa Niger\n| Moov Africa Central African Republic\n| Moov Africa Chad\n}}"},"industry":{"wt":"[[Telecommunications]]"},"products":{"wt":"[[Landline|Landline phones]], [[Mobile phone|Mobile phone lines]], [[Fiber-optic communication|Fiber-optic Internet]], [[Asymmetric digital subscriber line|ADSL]], [[5G]]"},"revenue":{"wt":"{{increase}} [[US$]] 3,6 billion (2018)"},"net_income":{"wt":"{{increase}} [[US$]]  610 million (2018)"},"website":{"wt":"{{URL|https://www.iam.ma | iam.ma}}"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style><style data-mw-deduplicate="TemplateStyles:r1326365004" typeof="mw:Extension/templatestyles" about="#mwt4" data-mw='{"name":"templatestyles","attrs":{"src":"Infobox company/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .ib-company .infobox-label{padding-right:0.5em}.mw-parser-output .ib-company-logo img{background-color:#f8f9fa;color:inherit}.mw-parser-output .ib-company-logo .logo-nobg img{background-color:inherit;color:inherit}.mw-parser-output .ib-company-locality,.mw-parser-output .ib-company-country{display:inline}</style></span><table class="infobox ib-company vcard" about="#mwt2" id="mwBA"><tbody><tr><th colsp