					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Major library and cultural center in Alexandria, Egypt"}},"i":0}}]}'>Major library and cultural center in Alexandria, Egypt</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_matches_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"about","href":"./Template:About"},"params":{"1":{"wt":"the modern library in Alexandria"},"2":{"wt":"the ancient library founded by the Ptolemaic dynasty"},"3":{"wt":"Library of Alexandria"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2" id="mwBA">This article is about the modern library in Alexandria. For the ancient library founded by the Ptolemaic dynasty, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Library_of_Alexandria" title="Library of Alexandria">Library of Alexandria</a>.</div>
<p class="mw-empty-elt" id="mwBQ"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt4" id="mwBg" data-mw='{"parts":[{"template":{"target":{"wt":"Use dmy dates","href":"./Template:Use_dmy_dates"},"params":{"date":{"wt":"January 2024"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_dmy_dates_from_January_2024" about="#mwt4" id="mwBw"/></p>
<span class="mw-empty-elt" about="#mwt5" typeof="mw:Transclusion" id="mwCA" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox library\n","href":"./Template:Infobox_library"},"params":{"native_name":{"wt":"{{Lang|arz|مكتبة الإسكندرية}}&lt;br />{{Lang|es|Bibliotheca Alexandrina}}"},"name":{"wt":"Library of Alexandria"},"logo":{"wt":"Bibliotheca Alexandrina (logo).svg"},"logo_size":{"wt":""},"logo_alt":{"wt":""},"image":{"wt":"Alexandria&apos;s Bibliotheca.jpg"},"image_size":{"wt":"280"},"alt":{"wt":""},"caption":{"wt":"View of Bibliotheca Alexandrina in Alexandria"},"country":{"wt":"[[Egypt]]"},"type":{"wt":"[[National library]]"},"scope":{"wt":""},"established":{"wt":"{{start date and age|2002|10|16|df=yes}}"},"ref_legal_mandate":{"wt":""},"location":{"wt":"[[Alexandria]]"},"coordinates":{"wt":"{{Coord|31|12|32|N|29|54|33|E|region:EG-ALX_type:landmark|display=inline,title}}"},"branch_of":{"wt":""},"num_branches":{"wt":""},"items_collected":{"wt":""},"collection_size":{"wt":""},"criteria":{"wt":""},"legal_deposit":{"wt":""},"req_to_access":{"wt":""},"annual_circulation":{"wt":""},"pop_served":{"wt":""},"members":{"wt":"16,322 (2012)"},"budget":{"wt":""},"director":{"wt":"Ahmed Abdullah Zayed"},"num_employees":{"wt":""},"website":{"wt":"{{URL|https://www.bibalex.org/en/default|bibalex.org}}"},"references":{"wt":""},"embed":{"wt":""},"module":{"wt":""}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt6" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobo