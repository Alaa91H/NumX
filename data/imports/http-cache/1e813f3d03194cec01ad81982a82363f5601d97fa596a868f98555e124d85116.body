<li about="#cite_note-3" id="cite_note-3" data-mw-footnote-number="3"><span class="mw-cite-backlink" id="mwWw"><a href="#cite_ref-3" rel="mw:referencedBy" id="mwXA"><span class="mw-linkback-text" id="mwXQ">↑</span></a></span> <span id="mw-reference-text-cite_note-3" class="mw-reference-text reference-text">Coalition Provisional Authority <a rel="mw:ExtLink nofollow" href="http://www.cpa-iraq.org/regulations/20040204_CPAORD55.pdf" class="external text" id="mwXg">Order 55</a></span></li>
<li about="#cite_note-statement-4" id="cite_note-statement-4" data-mw-footnote-number="4"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwXw"><a href="#cite_ref-statement_4-0" id="mwYA"><span class="mw-linkback-text" id="mwYQ">1</span></a> <a href="#cite_ref-statement_4-1" id="mwYg"><span class="mw-linkback-text" id="mwYw">2</span></a></span> <span id="mw-reference-text-cite_note-statement-4" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt13" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwZA" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite press release ","href":"./Template:Cite_press_release"},"params":{"title":{"wt":"Statement of Judge Radhi Hamza al-Radhi before the U.S. House Committee on Oversight and Government Reform"},"publisher":{"wt":"Radhi Hamza al-Radhi"},"date":{"wt":"2007-10-04"},"url":{"wt":"http://oversight.house.gov/documents/20071004103646.pdf"},"url-status":{"wt":"dead"},"archiveurl":{"wt":"https://web.archive.org/web/20071101065442/http://oversight.house.gov/documents/20071004103646.pdf"},"archivedate":{"wt":"2007-11-01"}},"i":0}}]}'/><cite class="citation pressrelease cs1" about="#mwt13" id="mwZQ"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20071101065442/http://oversight.house.gov/documents/20071004103646.pdf" class="external text" id="mwZg">"Statement of Judge Radhi Hamza al-Radhi before the U.S. House Committee on Oversight and Government Reform"</a> <span class="cs1-format" id="mwZw">(PDF)</span> (Press release). Radhi Hamza al-Radhi. 2007-10-04. Archived from <a rel="mw:ExtLink nofollow" href="http://oversight.house.gov/documents/20071004103646.pdf" class="external text" id="mwaA">the original</a> <span class="cs1-format" id="mwaQ">(PDF)</span> on 2007-11-01.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Statement+of+Judge+Radhi+Hamza+al-Radhi+before+the+U.S.+House+Committee+on+Oversight+and+Government+Reform&amp;rft.pub=Radhi+Hamza+al-Radhi&amp;rft.date=2007-10-04&amp;rft_id=http%3A%2F%2Foversight.house.gov%2Fdocuments%2F20071004103646.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACommission+of+Integrity+%28Iraq%29" class="Z3988" about="#mwt13" id="mwag"></span></span></li>
<li about="#cite_note-5" id="cite_note-5" data-mw-footnote-number="5"><span class="mw-cite-backlink" id="mwaw"><a href="#cite_ref-5" rel="mw:referencedBy" id="mwbA"><span class="mw-linkback-text" id="mwbQ">↑</span></a></span> <span id="mw-reference-text-cite_note-5" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt16" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwbg" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite news ","href":"./Template:Cite_news"},"params":{"first":{"wt":"Alissa"},"last":{"wt":"Rubin"},"authorlink":{"wt":"Alissa J. Rubin"},"title":{"wt":"Blaming Politics, Iraqi Antigraft Official Vows to Quit"},"url":{"wt":"https://www.nytimes.com/2007/09/07/world/middleeast/07iraq.html"},"work":{"wt":"[[The New York Times]]"},"date":{"wt":"2007-09-07"}},"i":0}}]}'/><cite id="CITEREFRubin2007" class="citation news cs1" about="#mwt16"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Alissa_J._Rubin" title="Alissa J. Rubin" id="mwbw">Rubin, Alissa</a> (2007-09-07). <a rel="mw:ExtLink nofollow" href="https://www.nytimes.com/2007/09/07/world/middleeast/07iraq.html" class="external text" id="mwcA">"Blaming Politics, Iraqi Antigraft Official Vows to Quit"</a>. <i id="mwcQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_New_York_Times" title="The New York Times" id="mwcg">The New York Times</a></i>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+New+York+Times&amp;rft.atitle=Blaming+Politics%2C+Iraqi+Antigraft+Official+Vows+to+Quit&amp;rft.date=2007-09-07&amp;rft.aulast=Rubin&amp;rft.aufirst=Alissa&amp;rft_id=https%3A%2F%2Fwww.nytimes.com%2F2007%2F09%2F07%2Fworld%2Fmiddleeast%2F07iraq.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACommission+of+Integrity+%28Iraq%29" class="Z3988" about="#mwt16" id="mwcw"></span></span></li>
